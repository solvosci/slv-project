<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_custom_fields_form_view" model="ir.ui.view">
        <field name="name">project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page[1]" position="before">
                <page name="economic_data" string="Economic Data">
                    <group>
                        <group name="economic_data_group">
                            <field name="last_close_date"/>
                            <field name="estimated_cost" />
                            <field name="estimated_income" />
                            <field name="margin" string="Margin" widget="percentage" />
                        </group>    
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
