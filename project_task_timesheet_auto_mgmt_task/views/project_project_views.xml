<odoo>
    <record id="view_project_form_inherit_mgmt_task" model="ir.ui.view">
        <field name="name">project.project.form.inherit.mgmt.task</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_tasks_managment']/div" position="inside">
                <setting string="Create Management Task">
                    <field name="create_mgmt_task"
                            readonly="allow_timesheets == False"/>
                </setting>
            </xpath>
        </field>
    </record>
    <record id="project_project_view_form_simplified_inherit_mgmt_task" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.inherit.mgmt.task</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <setting string="Create Management Task">
                    <field name="create_mgmt_task"
                            readonly="allow_timesheets == False"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
