<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_project" model="ir.ui.view">
        <field name="name">project.project.form (in project_sale_link)</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_all_rating']" position="after">
                <button name="action_open_sale_orders" type="object" class="oe_stat_button" icon="fa-dollar" groups="sales_team.group_sale_salesman">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="sale_order_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">
                            Sale Orders
                        </span>
                    </div>
                </button>
                <button name="action_open_sale_order_lines" type="object" class="oe_stat_button" icon="fa-list" groups="sales_team.group_sale_salesman">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">
                            Sale Order Lines
                        </span>
                    </div>
                </button>
            </xpath>
            
        </field>
    </record>
</odoo>
