<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_project_form_view_inherited" model="ir.ui.view">
        <field name="name">project.project.form (in project_purchase_line_link)</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_purchase.project_project_form_view_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_project_purchase_orders']" position="after">
                <button name="action_open_purchase_lines" type="object" class="oe_stat_button" icon="fa-list" groups="purchase.group_purchase_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="purchase_order_lines_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">
                            Purchase Orders Lines
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
